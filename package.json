{
  "name": "visual-editor-pro",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run --filter @visual/web dev",
    "dev:h5": "turbo run --filter @visual/h5 dev",
    "build": "turbo run build",
    "build:web": "turbo run --filter @visual/web build",
    "build:h5": "turbo run --filter @visual/h5 build",
    "test": "pnpm --filter @visual/editor test",
    "preview": "turbo run preview",
    "type-check": "turbo run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check . && eslint .",
    "clean": "turbo run clean && rimraf node_modules pnpm-lock.yaml"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
