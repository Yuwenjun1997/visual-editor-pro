{
  "name": "@visual/editor",
  "version": "0.0.0",
  "description": "可视化编辑器组件模块：编辑器外壳、状态、控件与块注册（Vue3 + TS + Element Plus）",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind/index.css -o ./dist/style.css",
    "build:lib": "vite build",
    "type-check": "vue-tsc --noEmit",
    "clean": "rimraf dist"
  },
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./dist/style.css"
  },
  "files": ["src", "dist"],
  "sideEffects": ["./src/index.ts", "./src/styles/index.scss", "*.css"],
  "peerDependencies": {
    "vue": "^3.5.0",
    "pinia": "^2.3.0",
    "vue-router": "^4.5.0"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@visual/ui": "workspace:*",
    "@vueuse/core": "^12.0.0",
    "element-plus": "^2.9.0",
    "lodash": "^4.17.21",
    "monaco-editor": "^0.52.0",
    "nanoid": "^5.1.0",
    "uuid": "^11.1.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "rimraf": "^6.0.0",
    "sass": "^1.103.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "pinia": "^2.3.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}