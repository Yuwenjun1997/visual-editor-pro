{
  "name": "@visual/ui",
  "version": "0.0.0",
  "description": "visual 组件库：Vue3 + TS + reka-ui 的通用渲染组件集合",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind/index.css -o ./dist/style.css",
    "build:lib": "vite build",
    "type-check": "vue-tsc --noEmit",
    "clean": "rimraf dist"
  },
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./dist/style.css",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./hooks/*": "./src/hooks/*",
    "./components/*": "./src/components/*"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "./src/assets/scss/index.scss",
    "./src/assets/fonts/bootstrap/bootstrap-icons.css",
    "./src/assets/fonts/zcool-kuaile/zcool-kuaile.css",
    "*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "lodash": "^4.17.21",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.4",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.6.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "rimraf": "^6.0.0",
    "sass": "^1.103.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "unplugin-auto-import": "^19.0.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
